# Backend (prefixo XILOSCAN_)
XILOSCAN_DATASET_PATH=data/dataset_lpf.json
XILOSCAN_TAXONOMY_PATH=data/efv_taxonomy.json
XILOSCAN_IMAGES_ROOT=data/images

XILOSCAN_BACKBONE=tf_efficientnet_b4      # ou resnet50
XILOSCAN_EMBEDDING_DIM=512
XILOSCAN_IMAGE_SIZE=380
XILOSCAN_DEVICE=auto                       # auto | cuda | cpu | mps
XILOSCAN_CHECKPOINT=backend/artifacts/arcface_b4.pt

XILOSCAN_INDEX_PATH=backend/artifacts/xiloscan.faiss
XILOSCAN_INDEX_META_PATH=backend/artifacts/xiloscan_index.json
XILOSCAN_INDEX_TYPE=flat_ip                # ivf_pq quando passar de ~50k vetores

XILOSCAN_PESO_VISUAL=0.70
XILOSCAN_LIMIAR_ALTA_CONFIANCA=0.80
XILOSCAN_LIMIAR_MEDIA_CONFIANCA=0.60
XILOSCAN_MAX_UPLOAD_MB=12
